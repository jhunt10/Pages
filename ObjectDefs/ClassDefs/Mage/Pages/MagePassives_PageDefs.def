{
	"ChainShockExtend_PageItem": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemPassive.gd",
		"#ObjDetails": {
			"Description": "After lengthy experimentation with the @@#Color:Blue:Chain Shock Spell@@, you've found a reliable way to channel more energy and hit more targets, without totally vaporizing the first link in the chain.\n\n@@#Color:Blue:Chain Shock@@ can now chain up to @@#Color:Red:5 Actors@@.",
			"DisplayName": "Chain Longer",
			"LargeIcon": "Sprites/ChainPlus2_Icon.png",
			"ObjectType": "Item",
			"SmallIcon": "Sprites/ChainPlus2_Icon.png",
			"SnippetDesc": "+2 to Attack Chain length.",
			"Tags": [
				"Passive",
				"Chain"
			],
			"Taxonomy": [
				"Item",
				"Page",
				"Passive"
			]
		},
		"ItemData": {
			"ItemType": "Page",
			"Rarity": "Common",
			"Value": 50.0
		},
		"PageData": {
			"PageRequirements": {
				"ConflictingPages": [],
				"IncompatiblePages": [],
				"TitleReq": "Match"
			},
			"SourceTitle": "Mage",
			"_StatMods": {
				"MaxChainMod": {
					"ModType": "Add",
					"StatName": "ChainLengthBonus",
					"Value": 2.0
				}
			}
		},
		"PassiveData":{
			"ActionMods": {
				"ChainShockSpellMod": {
					"Conditions": {
						"ItemKeys": [
							"ChainShockSpell_PageItem"
						],
						"TagFilters": []
					},
					"ModdedDefData": {
						"ActionData": {
							"SubActions":{
								"GetTarget_Chain": {
									"MaxChainCount": 5
								}
							}
						}
					}
				}
			}
		},
		"_DefVersion": "1"
	},
	"ChainShockFork_PageItem": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemPassive.gd",
		"#ObjDetails": {
			"Description": "While reading a paper about something called \"Breadth First Search\", you accidently sat on a fork. And that gave you an idea...\n\n@@#Color:Blue:Chain Shock@@ can now @@#Color:Blue:Fork@@, splitting the @@#Color:Blue:Chain@@ to more reliably hitting the maximum number @@#Color:Red:Actors@@.",
