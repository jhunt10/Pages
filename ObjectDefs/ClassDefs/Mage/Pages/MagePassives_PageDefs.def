	"ColdMagePassive_PageItem": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemPassive.gd",
		"#ObjDetails": {
			"Description": "By limiting the @@#Color:DmgColor:Cold:Cold@@ energy of @@#Tag:Ice:Ice Spells@@, you're able to prevent the projectiles from freezing and instead deal @@#Tag:Physical:Physical Damage@@.\n\n@@#Tag:Spell:Spells@@ with the @@#Tag:Ice@@ tag are modified to deal @@#Color:DmgColor:Blunt@@, @@#Color:DmgColor:Pierce@@ or or @@#Color:DmgColor:Crash@@ Damage, and are resisted by @@#Stat:Armor@@. The new damage type depends on the spell.",
			"DisplayName": "Aqua Mage",
			"LargeIcon": "Sprites/AquaMage_Icon.png",
			"ObjectType": "Item",
			"SmallIcon": "Sprites/AquaMage_Icon.png",
			"SnippetDesc": "Ice Spells deal Physical Damage",
			"Tags": [
				"Passive",
				"ActionMod"
			],
			"Taxonomy": [
				"Item",
				"Page",
				"Passive"
			]
		},
		"ItemData": {
			"ItemType": "Page",
			"Rarity": "Common",
			"Value": 50.0
		},
		"PageData": {
			"PageRequirements": {
				"ConflictingPages": [],
				"IncompatiblePages": [],
				"TitleReq": "Match"
			},
			"SourceTitle": "Mage"
		},
		"PassiveData": {
			"ActionMods": {
				"WaterBallSpellMod": {
					"Conditions": {
						"ItemKeys": [
							"WaterBallSpell_PageItem"
						],
						"TagFilters": []
					},
					"ModdedDefData": {
						"#ObjDetails": {
							"DisplayName": "Water Ball",
							"Description": "Launch a @@#Tag:Missile@@ @@#Tag:SpellAtk:Spell Attack@@ at a @@#TrgParm:TargetParam:TargetType@@ in range, dealing @@#DmgData:MissileDamage@@ to any @@#Color:Red:Actor@@ it hits.\n\nOn impact the ball splashes launching @@#Tag:Missile:Missiles@@ at @@#Color:Red:Adj Spots@@, dealing @@#DmgData:SubMissileDamage@@ on hit.\n@@#EftChances@@\n-One of many spells banned from professional water balloon fights.",
							"SnippetDesc": "Launch a Ice Ball Missile",
							"Tags": [
							],
							"Taxonomy": [
								"Item",
								"Page",
								"Action"
							]
						},
						"ActionData": {
							"DamageDatas": {
								"MissileDamage": {
									"DamageType": "Blunt",
									"DefenseType": "Armor"
								},
								"SubMissileDamage": {
									"DamageType": "Pierce",
									"DefenseType": "Armor"
								}
							}
						}
					}
				},
				"WaterBeamSpell": {
					"Conditions": {
						"ItemKeys": [
							"WaterBeamSpell_PageItem"
						],
						"TagFilters": []
					},
					"ModdedDefData": {
						"#ObjDetails": {
							"DisplayName": "Water Beam",
							"Description": "Spawn a @@#Tag:Beam@@ of water, hitting @@#Color:Red:All Actors@@ in a @@#Color:Red:Line@@ in front of you and dealing @@#DmgData:WaterBeamDamage@@.\n\n-Also great for power washing the blood left behind after power washing enemies.",
							"LargeIcon": "Sprites/WaterBeam.png",
							"SmallIcon": "Sprites/WaterBeam.png",
							"Tags": [
							],
							"Taxonomy": [
								"Item",
								"Page",
								"Action"
							]
						},
						"ActionData": {
							"DamageDatas": {
								"WaterBeamDamage": {
									"DamageType": "Crash",
									"DefenseType": "Armor"
								}
							}
						}
					}
				},
				"WaterGunSpellMod": {
					"Conditions": {
						"ItemKeys": [
							"WaterGunSpell_PageItem"
						],
						"TagFilters": []
					},
					"ModdedDefData": {
						"#ObjDetails": {
							"DisplayName": "Water Gun",
							"Description": "Fire a rapid series of @@#Tag:Ranged@@ @@#Tag:SpellAtk:Spell Attack@@ against an @@#TrgParm:TargetParam:TargetType@@ in range, dealing @@#DmgData:RangedDamage@@ on hit.\n\n-Summer time fun turned deadly.",
							"Tags": [
