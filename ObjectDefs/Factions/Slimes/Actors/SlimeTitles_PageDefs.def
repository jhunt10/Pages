{
	"SlimeBase_TitlePage": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemTitle.gd",
		"!ParentKey": "#BaseTitlePage",
		"#ObjDetails": {
			"Description": "@@#Color:Red:Slimes@@ are gelatinous blobs of biological paradoxes, and general inconveniences. \n\nTheir malleable forms lack any @@#Stat:Armor@@, yet still possess high @@#Tag:Resistance@@ to all forms of @@#Tag:Physical@@ damage. And with no eyes so speak of, they register as @@#Tag:NonDir:Non-Directional@@, and are immune to @@#EftDef:AilmentBlind:Link@@ (sorry, @@#Color:Blue:Rogue@@).\n\nDispite these abnormalities, researchers have been able to prove that @@#Color:Red:Slimes@@ will die if you stab them enough, and thus, meet the scientific definition of \"Life\". But the council still does not grant them the @@#Color:Blue:Tag@@ of @@#Tag:Living@@.",
			"DisplayName": "Slime",
			"LargeIcon": "Sprites/BlueSlime_Icon.png",
