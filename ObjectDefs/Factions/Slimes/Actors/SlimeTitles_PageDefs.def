	"SlimePoison_TitlePage": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemTitle.gd",
		"!ParentKey": "SlimeBase_TitlePage",
		"#ObjDetails": {
			"Description": "With a high tolerance to toxins and poor personal hygiene, @@#Color:Red:Slimes@@ often become polluted with whatever is in their environment. If this includes material with strong @@#Tag:Magical:Magical Energy@@, the @@#Color:Blue:PAGE@@ System appears to misinterpret the @@#Color:Red:Slime@@ as being made of the given material.\nAt that point, the @@#Color:Red:Slime@@ will alter it's color to conform to cultural norms.\n\n@@#Color:Red:Green Slimes@@ have absorbed large amounts of poisonous plants, toxic waste, and internet comment sections. Any contact with their surface is recognized as @@#Color:DmgColor:Poison:Poison Damage@@ and can be potent enough to inflict a @@#EftDef:AilmentPoisoned:Link@@ status upon the idiot who touched a @@#Color:Red:Poison Slime@@ with their bare hands.",
			"DisplayName": "Poison Slime",
			"LargeIcon": "Sprites/GreenSlime_Icon.png",
			"ObjectType": "Item",
