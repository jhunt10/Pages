	"BarrelActor": {
		"!ParentKey": "#BaseObjectActor",
		"#ObjDetails": {
			"Description": "@@#Color:Red:Barrels@@ were first invented as a subsite for @@#Color:Red:Pinatas@@ during the @@#Color:Red:Great Papier-Mache Wars@@. But failed to find popularity among @@#Color:Grey:Children@@ due to their boring design and difficulty to break.\n\nAfter the extinction of @@#Color:Grey:Children@@ and resulting end to all birthday parties, people have found them useful for storing @@#Tag:Supplies@@ and providing a rustic feel.\n\nSome more nostalgic adventurers still prefer to use them for their original purpose.",
			"DisplayName": "Barrel",
			"LargeIcon": "Sprites/Barrel_Icon.png",
			"ObjectType": "Actor",
			"SmallIcon": "Sprites/Barrel_Icon.png",
			"SnippetDesc": "a barrel",
			"Tags": [
				"Object"
			],
			"Taxonomy": [
				"Actor",
				"Object"
			]
		},
		"ActorData": {
			"DropItemsSet": {
