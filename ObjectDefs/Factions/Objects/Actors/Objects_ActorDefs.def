				"HealthPotionL": 1.0,
				"HealthPotionM": 5.0,
				"HealthPotionS": 10.0,
				"Mag_Ammo": 10.0,
				"Phy_Ammo": 10.0
			}
		},
		"ScenePath": "res://Scenes/Combat/MapObjects/Actors/SimpleActorNode/simple_actor_node.tscn",
		"SpriteData": {
			"SpriteFrameWH": [
				12.0,
