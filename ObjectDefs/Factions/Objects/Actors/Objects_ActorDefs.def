		},
		"_DefVersion": "1"
	},
	"CrateActor": {
		"!ParentKey": "#BaseObjectActor",
		"#ObjDetails": {
			"Description": "@@#Color:Red:Crates@@ are like the older more mature sibling of @@#Color:Red:Barrels@@. While @@#Color:Red:Barrels@@ are off rolling down hills and filling themselves with beer, @@#Color:Red:Crates@@ are working diligently storing items in warehouses and working as makeshift tables.\n\nMany of the more euclidean minded folks will argue that @@#Color:Red:Crates@@ are superior due to their greater volume and packability. But honestly if you're just breaking them it's all them same.",
			"DisplayName": "Crate",
			"LargeIcon": "Sprites/Crate_Icon.png",
			"ObjectType": "Actor",
			"SmallIcon": "Sprites/Crate_Icon.png",
			"SnippetDesc": "a crate",
