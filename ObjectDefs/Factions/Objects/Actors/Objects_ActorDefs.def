	"ShrineActor": {
		"!ObjectScript": "res://ObjectDefs/Factions/Objects/Actors/Scenes/Shrine/SpawnerActor.gd",
		"!ParentKey": "#BaseObjectActor",
		"#ObjDetails": {
			"Description": "These @@#Color:Red:Shrines@@ serve as a protective barrier guarding the old entrance to @@#Color:Blue:The City@@.\n\nConcerned by the prospect of @@#Color:Red:Monsters@@ attacking through @@#Color:Blue:The Cave@@ connected to @@#Color:Blue:The Sewers@@, @@#Color:Blue:The Military@@ asked @@#Color:Blue:The Church@@ to erect a magical barrier.\n\nThe @@#Color:Red:Priests@@ at @@#Color:Blue:The Church@@ didn't want to addmit they couldn't do that (since it's more of a @@#Color:Red:Mage@@ thing), so instead they built @@#Color:Red:Shrines@@ to summon @@#Color:Red:Zombies@@ as guards.\n\nTampering with these @@#Color:Red:Shrines@@ is a capital offence punishable by life in prison or penalty of death. Which is kind of the same thing.",
			"DisplayName": "Shrine",
			"LargeIcon": "Sprites/Shrine_Icon.png",
			"ObjectType": "Actor",
			"SmallIcon": "Sprites/Shrine_Icon.png",
			"SnippetDesc": "a shrine",
			"Tags": [
				"Object",
				"Rooted"
			],
			"Taxonomy": [
				"Actor",
				"Object"
			]
		},
		"ScenePath": "Scenes/Shrine/shrine_actor_node.tscn",
		"SpriteFrameWH": [
			7.0,
			1.0
		],
		"SpriteOffset": [
			0.0,
			-16.0
		],
		"SpriteSheet": "Sprites/Shrine_SpriteSheet.png",
		"_DefVersion": "1"
	},
	"StalagmiteActor": {
		"!ParentKey": "#BaseObjectActor",
		"#ObjDetails": {
			"DisplayName": "Stalagmite",
			"Description": "@@#Color:Red:Stalagmites@@ are rock formations that rises from the floor of @@#Color:Blue:The Cave@@ through the accumulation of minerals in one @@#Color:Blue:Spot@@. While made of natural stone, they are actually quite brittle and occationally contain @@#Color:Blue:Items@@ for some reason.\n\nResearchers at @@#Color:Blue:The Collage@@ theorize that @@#Color:Red:Stalagmites@@ are formed by the dripping of mineral rich water from @@#Color:Grey:Stalactites@@ attached to the ceiling of @@#Color:Blue:The Cave@@. But these theories can not be confirmed as no one has ever observed this so called \"ceiling\".",
			"LargeIcon": "Sprites/Stalagmite_Icon.png",
			"ObjectType": "Actor",
			"SmallIcon": "Sprites/Stalagmite_Icon.png",
			"SnippetDesc": "a stalagmite",
