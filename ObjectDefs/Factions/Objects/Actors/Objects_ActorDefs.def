	"LeverActor": {
		"!ObjectScript": "res://ObjectDefs/Factions/Objects/Actors/Scenes/Lever/LeverActor.gd",
		"!ParentKey": "#BaseObjectActor",
		"#ObjDetails": {
			"Description": "In an age where buttons and switches have dominated the mechanical control market, many consumers find they've been looking for a more reliable solution. They've been looking for @@#Color:Red:The Lever@@!\n\nSuperior to the switch in both durability and dramatic effect, the @@#Color:Red:Levels@@ can be flipped with even the toughest of @@#Tag:Attack:Attacks@@ or @@#Tag:Collision:Collisions@@, and stay @@#Tag:Rooted@@. Each comes standard with our patented @@#Color:Blue:Flip-Once@@ safe-guard, so you'll rest easy knowing it stays flipped.\n\nWhether you're a scientist bring life to your homemade monster, or a trolly driver looking to minimise casualties, you can trust a @@#Color:Red:Level@@ to let @@#Color:Blue:The World@@ know you did something.",
			"DisplayName": "Lever",
			"LargeIcon": "Sprites/Lever_Icon.png",
			"ObjectType": "Actor",
			"SmallIcon": "Sprites/Lever_Icon.png",
			"SnippetDesc": "a lever",
			"Tags": [
				"Object",
				"Lever",
				"Rooted"
			],
			"Taxonomy": [
				"Actor",
				"Object"
			]
		},
		"ScenePath": "Scenes/Lever/lever_actor_node.tscn",
		"SpriteData": {
			"SpriteFrameWH": [
				1.0,
				1.0
			],
			"SpriteOffset": [
				0.0,
				0.0
			],
			"SpriteSheet": "Sprites/Lever_SpriteSheet.png"
		},
		"_DefVersion": "1"
	},
	"SilverChestActor": {
		"!ObjectScript": "res://ObjectDefs/Factions/Objects/Actors/Scenes/Chest/ChestActor.gd",
		"!ParentKey": "#BaseObjectActor",
		"#ObjDetails": {
			"Description": "@@#Color:Red:Chests@@ are one of the greatest mystories of @@#Color:Blue:The World@@. They appear in remote locations, open with the slightest @@#Color:Red:Attack@@, then disapear leaving behind only a single @@#Color:Blue:Item@@.\n\nMany have speculated about thier origin.\nWho builds them? Who fills them? Are they a reward from @@#Color:Blue:Heaven@@ or temptation from @@#Color:Blue:Hell@@?\n\nThese are the things that we will never know.\n\n@@#Color:Grey:Dev Note\\: Every Chest is a baby Mimic, but they never get to level up because they spawn with 1 HP and everyone opens boxes by hitting them \\:(@@",
			"DisplayName": "Silver Chest",
			"LargeIcon": "Sprites/ChestSilver_Icon.png",
			"ObjectType": "Actor",
			"SmallIcon": "Sprites/ChestSilver_Icon.png",
			"SnippetDesc": "a chest",
			"Tags": [
				"Object",
				"Chest",
				"Rooted"
			],
			"Taxonomy": [
				"Actor",
				"Object"
			]
		},
		"ScenePath": "Scenes/Chest/chest_actor_node.tscn",
		"SpriteData": {
			"SpriteSheet": "Sprites/ChestSilver_SpriteSheet.png"
		},
		"_DefVersion": "1"
	},
	"GoldChestActor": {
		"!ObjectScript": "res://ObjectDefs/Factions/Objects/Actors/Scenes/Chest/ChestActor.gd",
		"!ParentKey": "#BaseObjectActor",
		"#ObjDetails": {
			"Description": "While @@#Color:Red:Silver Chest@@ may be common enough, only ancient legends tell of the elusive @@#Color:Red:Gold Chest@@.\n\nThese prized containers are said to hold the rarest of @@#Color:Red:Loot@@, but will only spawn in the presence of the fabled @@#Color:Blue:Heros@@ and once claimed, shall never spawn again.",
			"DisplayName": "Gold Chest",
			"LargeIcon": "Sprites/Chest_Icon.png",
			"ObjectType": "Actor",
			"SmallIcon": "Sprites/Chest_Icon.png",
