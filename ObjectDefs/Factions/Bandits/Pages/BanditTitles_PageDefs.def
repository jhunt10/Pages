	"BanditBase_TitlePage": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemTitle.gd",
		"!ParentKey": "#BaseTitlePage",
		"#ObjDetails": {
			"Description": "@@#Color:Red:Bandits@@ are a common threat to anyone traveling the @@#Color:Red:Cross Roads@@.\n\nMany believe @@#Color:Red:Bandits@@ to be the natural result of commerce. Just as @@#Color:Red:Slimes@@ spawn in areas with high @@#Color:Blue:Magic@@ density, so too will @@#Color:Red:Bandits@@ spawn where @@#Color:Blue:Money@@ flows. But in truth, they're mostly disgruntled veterans who couldn't find a job.\n\nThe average @@#Color:Red:Bandit@@ is a well rounded @@#Tag:Physical@@ fighter who balances offence and defense. They excel in close @@#Tag:Melee:Melee Combat@@, but struggle against @@#Tag:Magical:Magic Attacks@@ and the crushing weight of their many sins.",
			"DisplayName": "Bandit",
			"LargeIcon": "Sprites/BanditTitle_Icon.png",
			"ObjectType": "Item",
			"SmallIcon": "Sprites/BanditTitle_Icon.png",
			"SnippetDesc": "Bandit Title",
