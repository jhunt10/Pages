	"BanditCaptain_TitlePage": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemTitle.gd",
		"!ParentKey": "BanditBase_TitlePage",
		"#ObjDetails": {
			"Description": "Every ship needs a @@#Color:Red:Captain@@, and while @@#Color:Red:Bandits@@ are not necessarily ships, they do still benefit from well organized leadership.\n\n@@#Color:Red:Bandit Captains@@ earned their @@#Color:Blue:Title@@ thanks to their higher than average @@#Color:Blue:Stats@@. But naturally, they keep the best loot for themselves, which grants them even higher @@#Color:Blue:Stats@@, and the whole thing becomes a vicious cycle.\n\nThey like to live by the motto:\n\"Carry a big stick, and use it.\"",
			"DisplayName": "Bandit Captain",
			"LargeIcon": "Sprites/BanditCaptainTitle_Icon.png",
			"ObjectType": "Item",
			"SmallIcon": "Sprites/BanditCaptainTitle_Icon.png",
