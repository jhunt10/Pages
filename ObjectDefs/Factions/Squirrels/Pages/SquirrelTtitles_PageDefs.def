	"SquirrelMag_TitlePage": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemTitle.gd",
		"!ParentKey": "BaseSquirrel_TitlePage",
		"#ObjDetails": {
			"Description": "@@#Color:Red:Squirrcerer@@ are the @@#Tag:Magical:Magic@@ users of the @@#Color:Blue:NSO@@.\n\nThey have been trained in the forbidden @@#Color:Blue:Acornic Arts@@ granting access to powerful acorn related @@#Tag:Spell:Spells@@... well, \"@@#Tag:Spell@@\". They only have one, and all it can do is set an acorn on @@#Color:DmgColor:Fire@@ which they then throw. So I guess really they are just a @@#Color:Red:Squirrel@@ with a lighter that happens to only works on acorns.\n\nStill, they are technically @@#Tag:Ranged:Spell Casters@@ so they prefer to stay on the back line and fair poorly against @@#Tag:Physical:Hint:Physical Attacks@@ or, in their case, being stepped on.",
			"DisplayName": "Squirrcerer",
