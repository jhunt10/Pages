	"SquirrelPhy_TitlePage": {
		"!ObjectScript": "res://assets/Scripts/Items/Pages/PageItemTitle.gd",
		"!ParentKey": "BaseSquirrel_TitlePage",
		"#ObjDetails": {
			"Description": "@@#Color:Red:Squirrior@@ are the @@#Tag:Armor:Hint:Armored@@ defenders of the @@#Color:Blue:NSO@@.\n\nThey sacrifice their natural squirrelish @@#Stat:Evasion@@ for greater @@#Stat:Armor@@ to become an impenetrable wall. Not a very tall wall, mind you. Most people just step over them. But, they try.\n\nFollowing the emergence of the @@#Color:Blue:NSO@@, @@#Color:Blue:The Military@@ commissioned researchers at @@#Color:Blue:The Collage@@ to uncover how these tiny fighters were able to achieve such high @@#Color:Red:Armor@@ with such tiny @@#Tag:Equipment@@. After decades of grant funded research, they concluded: \"Probably Magic\".",
			"DisplayName": "Squirrior",
